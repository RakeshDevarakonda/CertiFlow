{
  "name": "backend",
  "version": "1.0.0",
  "description": "CertiFlow Backend Service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "setup:run": "npx prisma db push --skip-generate && npm run prisma:seed && npm run dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "certiflow",
    "skilling",
    "verification"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/pdfkit": "^0.17.7",
    "bcryptjs": "^3.0.3",
    "celebrate": "^16.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5"
  }
}
